# Copy this file to .env and fill in real values.
# Never commit .env.

# --- Azure OpenAI (used for credit-transaction classification) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# --- Service ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Limits ---
LLM_REQUEST_TIMEOUT_S=120
MAX_PDF_BYTES=20000000

# --- PaddleOCR service (the single OCR backend for every service: ocr_classifier
#     directly, and ocr_slip / ocr_sk / ocr_mutasi as a parser fallback) ---
OCR_ENDPOINT_URL=http://10.213.128.42:8060/predict/markdown
OCR_API_KEY=<your-ocr-api-key>
OCR_SKIP_ORIENTATION=false
OCR_TIMEOUT_S=120

# --- ocr_classifier limits ---
MAX_CLASSIFY_CHARS=8000
BATCH_OCR_CONCURRENCY=4

# --- Service URLs (local ports) ---
# OCR_SLIP_URL / OCR_MUTASI_URL are consumed by ocr_match; the rest are a
# central registry for reference and future cross-service calls.
OCR_CLASSIFIER_URL=http://127.0.0.1:8000
OCR_SK_URL=http://127.0.0.1:8100
OCR_SLIP_URL=http://127.0.0.1:8200
OCR_MUTASI_URL=http://127.0.0.1:8300
OCR_MATCH_URL=http://127.0.0.1:8400

# --- ocr_sk (Surat Keterangan Kerja): enable the LLM text fallback ---
KETERANGAN_KERJA_FALLBACK=true

# --- ocr_orchestrator (port 8500) ---
# Fans out to the four services above; reuses their OCR_*_URL registry entries.
# Tunables (defaults shown):
# UPSTREAM_TIMEOUT_S=180          # generous — covers the slow mutasi batch parse
# DEFAULT_BONUS_ACCEPT_PCT=0.0    # analyst bonus-acceptance fraction (0..1)
# JOB_RETENTION=200               # most-recent in-memory jobs kept
OCR_ORCHESTRATOR_URL=http://127.0.0.1:8500
