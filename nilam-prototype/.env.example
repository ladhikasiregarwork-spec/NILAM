# NILAM prototype — Next.js BFF environment.
# Copy to .env.local and adjust to your running services.

# Authoritative calc/decision/orchestration backend (nilam_backend, FastAPI).
# Used by app/api/applications/* to drive the pipeline and assemble the view.
NILAM_BACKEND_URL=http://127.0.0.1:8600

# Upstream OCR / data services used by app/api/ocr/* and app/api/{slik,npw,agunan}.
# NOTE: align these with the real service ports (see repo CLAUDE.md):
#   classifier 5001 · sk 5002 · slip 5003 · mutasi 5004 · match 5005 · npw 8000
CLASSIFIER_URL=http://127.0.0.1:5001
SK_OCR_URL=http://127.0.0.1:5002
SLIP_GAJI_OCR_URL=http://127.0.0.1:5003
NPW_URL=http://127.0.0.1:8000

# Demo-only UI controls (OCR Lengkap|Gap simulator). Set false to hide.
NEXT_PUBLIC_DEMO_CONTROLS=true
